<group name="local,syslog,sshd,">
  <!-- Cảnh báo Brute-force: Sai mật khẩu 5 lần trong vòng 60 giây -->
  <rule id="100001" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>SSH Brute-Force Attack Detected: Nhận diện nhiều lần đăng nhập thất bại từ cùng một IP.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>
</group>